{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|apply_patch|Edit|Write|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .agents/hooks/guard.ps1",
            "timeout": 30,
            "statusMessage": "Checking guardrails"
          }
        ]
      }
    ]
  }
}
